# ==============================================================================
# TransmuteAI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-transmuteai-secret-key-32bytes

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","https://transmuteai.vercel.app"]

# Execution Mode: "celery" (requires Redis) or "direct" (in-process background tasks for free/lightweight deployment)
EXECUTION_MODE=direct

# LLM Provider Configuration: "gemini", "ollama", "openai", or "mock"
LLM_PROVIDER=gemini

# Google Gemini Settings (Free Tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Air-Gapped / Ollama Local LLM Settings
AIR_GAPPED_MODE=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Fallback Settings (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL in production / Docker, falls back to SQLite if empty)
DATABASE_URL=sqlite+aiosqlite:///./storage/transmuteai.db

# Redis / Celery Configuration (Optional if EXECUTION_MODE=direct)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage Paths
STORAGE_DIR=./storage
ARTIFACTS_DIR=./storage/artifacts
UPLOADS_DIR=./storage/uploads
LEDGER_DIR=./storage/ledger

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend Next.js Public API URL (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
